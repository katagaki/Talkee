    "Summary.Instructions" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are a precise writing assistant. Output well-structured Markdown only, with no preamble. Reply in the same language as the transcript."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたは正確な文章作成のアシスタントです。前置きなしで、整理されたMarkdownのみを出力してください。文字起こしと同じ言語で返答してください。"
          }
        }
      }
    },
