    "Summary.Prompt.ActionTasks" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extract every actionable item, decision, or follow-up from the transcript below as a Markdown task list (`- [ ]`). Group related tasks under `##` subheadings, and append owners or deadlines in italics if mentioned."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以下の文字起こしから、すべてのアクション項目、決定事項、フォローアップを抽出し、Markdownのチェックリスト形式（`- [ ]`）にしてください。関連するタスクは`##`の小見出しでまとめ、担当者や期限が言及されていれば末尾に斜体で追記してください。"
          }
        }
      }
    },
    "Summary.Prompt.KeyPoints" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Summarize the transcript below as a Markdown bulleted list of 5–10 concise key points. Each bullet should be a single sentence capturing a fact, conclusion, or notable claim — no filler."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以下の文字起こしを、5〜10項目の簡潔な要点としてMarkdownの箇条書きにまとめてください。各項目は1文で、事実・結論・注目すべき主張を捉え、余計な内容を含めないでください。"
          }
        }
      }
    },
    "Summary.Prompt.Outline" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create a hierarchical outline of the transcript below using Markdown headings (`##`, `###`) and nested bullets. Preserve the order of topics and the speaker's intent. Do not invent content."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以下の文字起こしを、Markdownの見出し（`##`、`###`）と入れ子の箇条書きを用いて階層的なアウトラインにしてください。話題の順序と話者の意図を保ち、内容を創作しないでください。"
          }
        }
      }
    },
    "Summary.Prompt.Timeline" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Produce a chronological timeline from the transcript below as a Markdown bulleted list. Begin each bullet with a timestamp `**mm:ss**` when one is available, followed by a one-sentence event description in the order events occur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以下の文字起こしから、出来事を発生順にまとめた時系列のMarkdown箇条書きを作成してください。タイムスタンプがある場合は各項目の冒頭に`**mm:ss**`を付け、その後に1文で出来事を説明してください。"
          }
        }
      }
    },
